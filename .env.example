# Recycle Bin Environment Variables

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection URL (Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recycle_bin

# Security Configuration
JWT_SECRET=crty_recycle_bin_secret_key
API_KEY=crty_api_key_default
CORS_ORIGINS=*

# Retention Policies
RETENTION_DAYS=30
